# Copy this file to .env and adjust values before running in anything beyond local demo use.

PORT=3000

# Demo admin login (used by POST /api/auth/login).
# For real production use, replace this with a proper users table with per-admin
# hashed passwords instead of one shared credential in an env var.
ADMIN_EMAIL=admin@fixmyphone.com
ADMIN_PASSWORD=Admin@123

# Secret used to sign admin JWTs. Change this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
