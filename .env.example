# FixMyPhone Environment Variables Example
# Add these variables to your Vercel Project Settings for production deployment

# Admin Authentication
ADMIN_EMAIL=admin@fixmyphone.com
ADMIN_PASSWORD=
JWT_SECRET=

# Server & CORS Configuration
NODE_ENV=production
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: Disable automatic browser launch in local dev
AUTO_OPEN=false
